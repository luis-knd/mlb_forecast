# Base de datos
DATABASE_URL=postgresql://username:password@localhost:5432/mlb_forecast
SQL_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
POSTGRES_DB=mlb_forecast
POSTGRES_USER=username
POSTGRES_PASSWORD=password

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_TIMEOUT=5

# API Externa
MLB_API_BASE_URL=https://statsapi.mlb.com/api
MLB_API_VERSION=v1
MLB_API_TIMEOUT=10
MLB_API_MAX_RETRIES=2
MLB_API_BACKOFF_FACTOR=0.5

# Aplicación
APP_NAME="MLB Forecast API"
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Configuración de caché (en segundos)
CACHE_DEFAULT_TTL=3600
CACHE_GAMES_TTL=1800
CACHE_STATS_TTL=7200

# Machine Learning
ML_MODEL_RETRAIN_INTERVAL=86400
ML_MIN_GAMES_FOR_PREDICTION=10

# Rate Limiting
API_RATE_LIMIT_CALLS=100
API_RATE_LIMIT_WINDOW=60

# Configuración para producción
# DATABASE_URL=postgresql://usuario:password@host:5432/mlb_forecast_prod
# REDIS_URL=redis://host:6379/0
# ENVIRONMENT=production
# DEBUG=false
